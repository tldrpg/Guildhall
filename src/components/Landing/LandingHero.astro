---
/**
 * Landing hero. Deliberately dark in both themes — it reads as the table you play at,
 * and gives the three product cards below something to sit against.
 */
---

<section class="hero">
    <div class="grid" aria-hidden="true"></div>
    <div class="glow" aria-hidden="true"></div>

    <div class="body">
        <p class="eyebrow">Long Story Short</p>
        <h1>База знаний</h1>
        <p class="lead">
            Всё о наших инструментах для настольных ролевых игр: заполняемом листе
            персонажа для D&amp;D 5e, конструкторе листов Anima и комнатах Vortex.
        </p>

        <button class="roll" type="button" data-roll title="Бросить ещё раз">
            <span class="formula">1d20 + [STR]</span>
            <span class="arrow" aria-hidden="true">→</span>
            <span class="result" data-roll-result>18</span>
        </button>

        <div class="actions">
            <button class="action primary" type="button" data-search-trigger hidden>
                Искать по документации
                <kbd>Ctrl</kbd><kbd>K</kbd>
            </button>
            <a class="action" href="#часто-задаваемые-вопросы">Частые вопросы</a>
        </div>
    </div>
</section>

<script>
    // The dice chip re-rolls on click. Without JS it stays a perfectly good static number.
    const rollButton = document.querySelector('[data-roll]');
    const rollResult = document.querySelector('[data-roll-result]');

    if (rollButton instanceof HTMLElement && rollResult instanceof HTMLElement) {
        rollButton.addEventListener('click', () => {
            const value = Math.floor(Math.random() * 20) + 1 + 3;
            rollResult.textContent = String(value);
            rollButton.classList.remove('rolled');
            // Restart the animation on repeat clicks.
            void rollButton.offsetWidth;
            rollButton.classList.add('rolled');
        });
    }

    // Reuse Starlight's own search dialog rather than shipping a second one.
    // Shown only once we know the trigger exists, so it can never be a dead button.
    const searchTrigger = document.querySelector('[data-search-trigger]');
    const starlightSearch = document.querySelector('button[data-open-modal]');

    if (searchTrigger instanceof HTMLElement && starlightSearch instanceof HTMLElement) {
        searchTrigger.hidden = false;
        searchTrigger.addEventListener('click', () => starlightSearch.click());
    }
</script>

<style>
    .hero {
        position: relative;
        overflow: hidden;
        margin-bottom: 3rem;
        padding: clamp(2.5rem, 7vw, 4.5rem) clamp(1.5rem, 5vw, 3.5rem);
        border: 1px solid #2a2350;
        border-radius: 1.25rem;
        background: var(--lss-ink);
        color: var(--lss-paper);
    }

    /* A faint sheet grid — the thing every one of these products draws on. */
    .grid {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(247, 249, 255, 0.045) 1px, transparent 1px),
            linear-gradient(90deg, rgba(247, 249, 255, 0.045) 1px, transparent 1px);
        background-size: 44px 44px;
        mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, #000 40%, transparent 100%);
    }

    .glow {
        position: absolute;
        inset: -40% -10% auto -10%;
        height: 130%;
        background:
            radial-gradient(40rem 20rem at 15% 20%, rgba(71, 118, 230, 0.5), transparent 60%),
            radial-gradient(35rem 18rem at 85% 70%, rgba(142, 84, 233, 0.45), transparent 60%);
        filter: blur(6px);
    }

    .body {
        position: relative;
        max-width: 46rem;
    }

    .eyebrow {
        margin: 0 0 0.75rem;
        font-size: var(--sl-text-xs);
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #a9b6e8;
    }

    h1 {
        margin: 0;
        font-family: var(--lss-display);
        font-size: clamp(2.5rem, 7vw, 4rem);
        font-weight: 700;
        line-height: 1.05;
        color: var(--lss-paper);
    }

    .lead {
        margin: 1rem 0 0;
        max-width: 38rem;
        font-size: var(--sl-text-lg);
        line-height: 1.6;
        color: rgba(247, 249, 255, 0.75);
    }

    /* Dice chip: a formula the way the app itself renders one. */
    .roll {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 2rem;
        padding: 0.6rem 1rem;
        border: 1px solid rgba(247, 249, 255, 0.16);
        border-radius: 0.75rem;
        background: rgba(247, 249, 255, 0.05);
        font-family: var(--lss-mono);
        font-size: var(--sl-text-sm);
        color: rgba(247, 249, 255, 0.8);
        cursor: pointer;
    }

    .roll:hover {
        border-color: rgba(251, 212, 109, 0.5);
    }

    .arrow {
        opacity: 0.5;
    }

    .result {
        display: inline-block;
        min-width: 2ch;
        text-align: center;
        font-size: var(--sl-text-base);
        color: var(--lss-yellow);
    }

    .roll.rolled .result {
        animation: pop 0.28s ease-out;
    }

    @keyframes pop {
        0% {
            transform: translateY(-0.25rem) scale(0.9);
            opacity: 0.3;
        }
        100% {
            transform: none;
            opacity: 1;
        }
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2rem;
    }

    .action {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.7rem 1.25rem;
        border: 1px solid rgba(247, 249, 255, 0.2);
        border-radius: 0.6rem;
        background: transparent;
        color: var(--lss-paper);
        font-size: var(--sl-text-base);
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
    }

    .action:hover {
        border-color: rgba(247, 249, 255, 0.45);
        background: rgba(247, 249, 255, 0.06);
        color: var(--lss-paper);
    }

    .action.primary {
        border-color: transparent;
        background: linear-gradient(135deg, var(--lss-blue), var(--lss-purple));
    }

    .action.primary:hover {
        filter: brightness(1.1);
        background: linear-gradient(135deg, var(--lss-blue), var(--lss-purple));
    }

    .action kbd {
        padding: 0.1rem 0.35rem;
        border: 1px solid rgba(247, 249, 255, 0.3);
        border-radius: 0.25rem;
        background: rgba(7, 3, 26, 0.25);
        font-family: var(--lss-mono);
        font-size: var(--sl-text-xs);
    }

    @media (prefers-reduced-motion: reduce) {
        .roll.rolled .result {
            animation: none;
        }
    }
</style>
