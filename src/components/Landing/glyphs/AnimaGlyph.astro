---
/** Anima's editor: widgets of different sizes snapped to the canvas grid. */
---

<svg viewBox="0 0 120 64" fill="none" xmlns="http://www.w3.org/2000/svg" role="presentation">
    <defs>
        <pattern id="anima-grid" width="15" height="16" patternUnits="userSpaceOnUse">
            <circle cx="1" cy="1" r="1" fill="currentColor" fill-opacity="0.3" />
        </pattern>
    </defs>
    <rect width="120" height="64" fill="url(#anima-grid)" />

    <rect x="2" y="2" width="42" height="28" rx="5" fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-opacity="0.45" />
    <rect x="50" y="2" width="68" height="12" rx="5" fill="currentColor" fill-opacity="0.12" stroke="currentColor" stroke-opacity="0.3" />
    <rect x="50" y="18" width="32" height="44" rx="5" fill="currentColor" fill-opacity="0.12" stroke="currentColor" stroke-opacity="0.3" />
    <rect x="88" y="18" width="30" height="20" rx="5" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-opacity="0.35" />
    <rect x="2" y="34" width="42" height="28" rx="5" fill="currentColor" fill-opacity="0.12" stroke="currentColor" stroke-opacity="0.3" />
    <rect x="88" y="42" width="30" height="20" rx="5" fill="currentColor" fill-opacity="0.12" stroke="currentColor" stroke-opacity="0.3" />
</svg>

<style>
    svg {
        width: 100%;
        max-width: 11rem;
        height: auto;
    }
</style>
