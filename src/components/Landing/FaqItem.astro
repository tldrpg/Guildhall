---
interface FaqItemProps {
    question: string;
}

const { question } = Astro.props as FaqItemProps;
---

<details class="faq">
    <summary>
        <span>{question}</span>
        <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
        </svg>
    </summary>
    <div class="answer">
        <slot />
    </div>
</details>

<style>
    .faq {
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 1rem;
        padding: 0 1.25rem;
        background: var(--sl-color-gray-6);
        transition: border-color 0.15s ease;
        margin-top: 0 !important;
    }

    .faq[open] {
        border-color: var(--sl-color-gray-4);
    }

    summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.1rem 0;
        font-size: var(--sl-text-base);
        font-weight: 600;
        color: var(--sl-color-white);
        cursor: pointer;
        list-style: none;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary:hover {
        color: var(--sl-color-accent-high);
    }

    .chevron {
        flex: none;
        width: 1.25rem;
        height: 1.25rem;
        color: var(--sl-color-gray-3);
        transition: transform 0.15s ease;
    }

    .faq[open] .chevron {
        transform: rotate(180deg);
    }

    .answer {
        padding-bottom: 1.25rem;
        color: var(--sl-color-gray-2);
    }

    /* The slot holds markdown, so tighten the paragraph rhythm Starlight sets. */
    .answer :global(p) {
        margin: 0;
        line-height: 1.7;
    }

    .answer :global(p + p) {
        margin-top: 0.75rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .chevron {
            transition: none;
        }
    }
</style>
