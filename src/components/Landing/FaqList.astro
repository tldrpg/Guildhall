---
import FaqItem from './FaqItem.astro';
import { faq } from '../../data/faq';
---

<div class="faq-list">
    {
        faq.map((entry) => (
            <FaqItem question={entry.question}>
                <p set:html={entry.answer} />
            </FaqItem>
        ))
    }
</div>

<style>
    .faq-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
</style>
