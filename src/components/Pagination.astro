---
// Restyled to match the ProductCard system (rounded surface, accent-on-hover)
// instead of Starlight's thin-border default, which looked out of place next
// to the rest of the redesigned site.
import { Icon } from '@astrojs/starlight/components';

const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const isRtl = dir === 'rtl';
---

<div class="pagination-links print:hidden" dir={dir}>
    {
        prev && (
            <a href={prev.href} rel="prev">
                <Icon name={isRtl ? 'right-arrow' : 'left-arrow'} size="1.5rem" />
                <span>
                    {Astro.locals.t('page.previousLink')}
                    <br />
                    <span class="link-title">{prev.label}</span>
                </span>
            </a>
        )
    }
    {
        next && (
            <a href={next.href} rel="next">
                <Icon name={isRtl ? 'left-arrow' : 'right-arrow'} size="1.5rem" />
                <span>
                    {Astro.locals.t('page.nextLink')}
                    <br />
                    <span class="link-title">{next.label}</span>
                </span>
            </a>
        )
    }
</div>

<style>
    .pagination-links {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
        gap: 1rem;
    }

    a {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 0.75rem;
        width: 100%;
        flex-basis: calc(50% - 0.5rem);
        flex-grow: 1;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 1rem;
        padding: 1rem 1.25rem;
        text-decoration: none;
        color: var(--sl-color-gray-2);
        background: var(--sl-color-gray-6);
        overflow-wrap: anywhere;
        transition: border-color 0.15s ease, transform 0.15s ease;
    }

    [rel='next'] {
        justify-content: end;
        text-align: end;
        flex-direction: row-reverse;
    }

    a:hover {
        border-color: var(--sl-color-text-accent);
        transform: translateY(-2px);
        color: var(--sl-color-gray-2);
    }

    a:hover .link-title {
        color: var(--sl-color-text-accent);
    }

    .link-title {
        color: var(--sl-color-white);
        font-size: var(--sl-text-lg);
        line-height: var(--sl-line-height-headings);
        transition: color 0.15s ease;
    }

    svg {
        flex-shrink: 0;
        opacity: 0.7;
    }

    @media (prefers-reduced-motion: reduce) {
        a:hover {
            transform: none;
        }
    }
</style>
